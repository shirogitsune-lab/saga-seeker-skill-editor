/* Saga & Seeker semantic theme: light */
QWidget {
    color: @TEXT@;
    font-size: 10pt;
}
QMainWindow, QMenuBar, QMenu {
    background: @BACKGROUND@;
    color: @TEXT@;
}
QWidget#appRoot {
    background: @CANVAS@;
}
QWidget#appRoot[backgroundEnabled="true"],
QMenuBar[backgroundEnabled="true"],
QScrollArea[backgroundEnabled="true"],
QWidget[glassViewport="true"][backgroundEnabled="true"],
QWidget#skillPage[backgroundEnabled="true"],
QStackedWidget#skillEditorStack[backgroundEnabled="true"] {
    background: transparent;
}
QFrame#summaryPanel, QFrame#statusBar, QFrame#editorPanel, QFrame#pickerPanel {
    background: @PANEL@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 10px;
}
QFrame#summaryPanel[backgroundEnabled="true"],
QFrame#statusBar[backgroundEnabled="true"] {
    background: @CHROME_GLASS@;
    border: 1px solid @GLASS_BORDER@;
}
QFrame#basicIdentityCard, QFrame#basicProfileCard, QFrame#basicImageCard {
    background: @SURFACE@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 12px;
}
QFrame#statusCard, QFrame#skillListCard,
QFrame#memoryListCard, QFrame#memoryEditorCard {
    background: @SURFACE@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 12px;
}
QFrame#basicIdentityCard[backgroundEnabled="true"],
QFrame#basicProfileCard[backgroundEnabled="true"],
QFrame#basicImageCard[backgroundEnabled="true"],
QFrame#statusCard[backgroundEnabled="true"],
QFrame#skillListCard[backgroundEnabled="true"],
QFrame#memoryListCard[backgroundEnabled="true"],
QFrame#memoryEditorCard[backgroundEnabled="true"],
QFrame#editorPanel[backgroundEnabled="true"],
QFrame#pickerPanel[backgroundEnabled="true"] {
    background: @CARD_GLASS@;
    border: 1px solid rgba(255, 255, 255, 80);
    border-top: 1px solid @CARD_HIGHLIGHT@;
    border-left: 1px solid @CARD_HIGHLIGHT@;
    border-bottom: 2px solid rgba(20, 35, 55, 38);
}
QFrame#basicGlassLayer {
    background: @PANEL@;
    border: 1px solid @PANE_BORDER@;
    border-radius: 16px;
}
QFrame#basicGlassLayer[backgroundEnabled="true"] {
    background: @GLASS@;
    border: 0;
}
QFrame#editorPanel[dragActive="true"] {
    border: @FOCUS_WIDTH@ solid @FOCUS@;
}
QLabel#dropHint {
    color: @SUCCESS@;
    font-weight: 600;
}
QLabel#characterName {
    color: @HEADING@;
    font-size: 16pt;
    font-weight: 600;
}
QLabel#sectionHeading {
    color: @HEADING@;
    font-size: 11pt;
    font-weight: 600;
}
QLabel#cardHeading {
    color: @HEADING@;
    font-size: 13pt;
    font-weight: 700;
}
QLabel#fieldLabel {
    color: @TEXT@;
    font-weight: 600;
}
QLabel#mutedText, QLabel#technicalValue {
    color: @MUTED_TEXT@;
}
QLabel#technicalValue {
    font-family: "Yu Gothic UI";
}
QLabel[state="normal"] {
    color: @SUCCESS@;
    font-weight: 600;
}
QLabel[state="modified"] {
    color: @WARNING@;
    font-weight: 600;
}
QLabel[state="error"] {
    color: @DANGER@;
    font-weight: 600;
}
QLabel[state="unloaded"] {
    color: @MUTED_TEXT@;
    font-weight: 600;
}
QLabel[badge="true"] {
    background: @BADGE_BACKGROUND@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 6px;
    padding: 3px 8px;
    color: @BADGE_TEXT@;
}
QPushButton {
    min-height: 34px;
    padding: 4px 12px;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 8px;
    background: @BUTTON@;
    color: @TEXT@;
}
QPushButton:hover {
    background: @BUTTON_HOVER@;
    border-color: @FOCUS@;
}
QPushButton:pressed {
    background: @BUTTON_PRESSED@;
}
QPushButton:disabled, QPushButton[role="primary"]:disabled {
    background: @DISABLED_BACKGROUND@;
    color: @DISABLED@;
    border-color: @BORDER@;
}
QPushButton[role="primary"] {
    background: @ACCENT@;
    border-color: @FOCUS@;
    color: @ACCENT_TEXT@;
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background: @ACCENT_HOVER@;
}
QPushButton[role="primary"]:pressed {
    background: @ACCENT_PRESSED@;
}
QPushButton[role="danger"] {
    background: @DANGER_BACKGROUND@;
    border-color: @DANGER@;
    color: @DANGER_TEXT@;
}
QPushButton[accordion="true"] {
    min-height: 40px;
    padding: 6px 12px;
    text-align: left;
    font-size: 11pt;
    font-weight: 600;
}
QPushButton[accordion="true"]:checked {
    background: @ALTERNATE@;
    border: @FOCUS_WIDTH@ solid @FOCUS@;
    color: @TEXT@;
}
QPushButton[category="true"] {
    min-height: 38px;
    min-width: 76px;
    padding: 6px 8px;
    text-align: center;
    font-size: 11pt;
    font-weight: 600;
}
QPushButton[filterOption="true"] {
    min-height: 34px;
    min-width: 58px;
    padding: 4px 10px;
    font-size: 10pt;
    font-weight: 600;
}
QPushButton[category="true"]:checked, QPushButton[filterOption="true"]:checked {
    background: @SELECTION@;
    border: @FOCUS_WIDTH@ solid @FOCUS@;
    color: @SELECTION_TEXT@;
    font-weight: 600;
}
QLabel#filterLabel {
    min-width: 32px;
    font-size: 10pt;
    font-weight: 600;
}
QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background: @INPUT@;
    color: @TEXT@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 3px;
    selection-background-color: @SELECTION@;
    selection-color: @SELECTION_TEXT@;
}
QLineEdit {
    min-height: 30px;
    padding: 2px 7px;
}
QLineEdit {
    placeholder-text-color: @MUTED_TEXT@;
}
QComboBox {
    min-height: 30px;
    padding: 2px 7px;
}
QComboBox QAbstractItemView {
    background: @INPUT@;
    color: @TEXT@;
    selection-background-color: @SELECTION@;
    selection-color: @SELECTION_TEXT@;
    border: @BORDER_WIDTH@ solid @BORDER@;
}
QTextEdit, QPlainTextEdit {
    padding: 8px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus, QTreeWidget:focus {
    border: @FOCUS_WIDTH@ solid @FOCUS@;
}
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    background: @DISABLED_BACKGROUND@;
    color: @DISABLED@;
    border-color: @BORDER@;
}
QTreeWidget {
    background: @INPUT@;
    color: @TEXT@;
    alternate-background-color: @ALTERNATE@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    selection-background-color: @SELECTION@;
    selection-color: @SELECTION_TEXT@;
}
QTreeWidget#personalitySlots, QTreeWidget#personalityResults {
    font-size: 10pt;
}
QTreeWidget#personalitySlots::item, QTreeWidget#personalityResults::item {
    min-height: 32px;
}
QTreeWidget::item {
    min-height: 30px;
    padding: 2px;
}
QTreeWidget::item:selected {
    background: @SELECTION@;
    color: @SELECTION_TEXT@;
    border: @SELECTION_BORDER_WIDTH@ solid @FOCUS@;
}
QHeaderView::section {
    background: @BUTTON@;
    color: @TEXT@;
    padding: 6px;
    border: 0;
    border-right: @BORDER_WIDTH@ solid @BORDER@;
    border-bottom: @BORDER_WIDTH@ solid @BORDER@;
}
QToolButton#sectionToggle {
    border: 0;
    padding: 6px 2px;
    color: @TEXT@;
    font-weight: 600;
    text-align: left;
}
QToolButton#sectionToggle:hover {
    color: @ACCENT@;
}
QToolButton#sectionToggle:focus {
    border: @FOCUS_WIDTH@ solid @FOCUS@;
}
QSplitter::handle {
    background: @SPLITTER@;
    width: 2px;
}
QSplitter#basicContentSplitter::handle {
    background: transparent;
}
QMenuBar::item:selected, QMenu::item:selected {
    background: @SELECTION@;
    color: @SELECTION_TEXT@;
}
QMenu::separator {
    background: @BORDER@;
    height: @BORDER_WIDTH@;
    margin: 4px 8px;
}
QRadioButton:disabled, QCheckBox:disabled {
    color: @DISABLED@;
}
QTabWidget::pane {
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 10px;
    background: @BACKGROUND@;
}
QTabWidget[basicActive="true"]::pane {
    border: @BORDER_WIDTH@ solid @PANE_BORDER@;
}
QTabWidget[backgroundEnabled="true"]::pane {
    border: 0;
    background: transparent;
}
QTabBar::tab {
    background: @BUTTON@;
    color: @TEXT@;
    border: @BORDER_WIDTH@ solid @BORDER@;
    border-radius: 7px;
    margin-right: 4px;
    padding: 9px 18px;
}
QTabBar::tab:selected {
    background: @PANEL@;
    border-bottom: @FOCUS_WIDTH@ solid @FOCUS@;
    font-weight: 600;
}
QTabBar::tab:focus {
    border: @FOCUS_WIDTH@ solid @FOCUS@;
}
